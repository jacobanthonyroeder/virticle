# Writes procs.gen.go from the procedure constants of the vendored go-libvirt: go generate ./internal/optrace
BEGIN {
	print "// Code generated by procs.awk from third_party/go-libvirt/internal/constants; DO NOT EDIT."
	print ""
	print "package optrace"
	print ""
}
FNR == 1 {
	if (n++) print "}\n"
	print (FILENAME ~ /qemu/ ? "var qemuProcs" : "var remoteProcs") " = map[uint32]string{"
}
/^\t(QEMU)?Proc[A-Za-z0-9]+ = [0-9]+$/ {
	name = $1
	sub(/^(QEMU)?Proc/, "", name)
	printf "\t%s: \"%s\",\n", $3, name
}
END { print "}" }
